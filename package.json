{
  "name": "cds-dbml",
  "version": "1.0.0",
  "description": "CAP plugin for DBML (Database Markup Language) generation",
  "keywords": [
    "cap",
    "cap-js",
    "cds",
    "database",
    "dbml",
    "nodejs",
    "plugin",
    "sap",
    "sap-cap"
  ],
  "homepage": "https://github.com/mauriciolauffer/cds-dbml#readme",
  "bugs": {
    "url": "https://github.com/mauriciolauffer/cds-dbml/issues"
  },
  "license": "MIT",
  "author": "Mauricio Lauffer",
  "repository": {
    "type": "git",
    "url": "https://github.com/mauriciolauffer/cds-dbml.git"
  },
  "workspaces": [
    ".",
    "example"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/lib/compile/index.js",
  "types": "./dist/lib/compile/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/compile/index.d.ts",
      "import": "./dist/lib/compile/index.js",
      "default": "./dist/lib/compile/index.js"
    },
    "./cds-plugin": {
      "types": "./dist/cds-plugin.d.ts",
      "import": "./dist/cds-plugin.js",
      "default": "./dist/cds-plugin.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/dbml.test.ts",
    "test:gen": "pnpm --filter cds-dbml-example generate:dbml",
    "lint": "oxfmt --check && oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@dbml/core": "^10.1.1"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.20.0",
    "@sap/cds": "^10.1.1",
    "@types/node": "^26.6.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@sap/cds": ">=8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1"
}
