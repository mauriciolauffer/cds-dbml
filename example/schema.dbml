Table "sap.capire.bookshop.Books" {
  "createdAt" timestamp [note: 'Created On']
  "createdBy" varchar(255) [note: 'Created By']
  "modifiedAt" timestamp [note: 'Changed On']
  "modifiedBy" varchar(255) [note: 'Changed By']
  "ID" integer [pk]
  "author_ID" integer
  "title" varchar(255)
  "descr" varchar(255)
  "genre_ID" varchar(36)
  "stock" integer
  "price" decimal(9, 2)
  "currency_code" varchar(3)
}

Table "sap.capire.bookshop.Authors" {
  "createdAt" timestamp [note: 'Created On']
  "createdBy" varchar(255) [note: 'Created By']
  "modifiedAt" timestamp [note: 'Changed On']
  "modifiedBy" varchar(255) [note: 'Changed By']
  "ID" integer [pk]
  "name" varchar(255)
  "dateOfBirth" date
  "dateOfDeath" date
  "placeOfBirth" varchar(255)
  "placeOfDeath" varchar(255)
}

Table "sap.capire.bookshop.Genres" {
  "ID" varchar(36) [pk]
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "parent_ID" varchar(36)
}

Table "sap.common.Languages" {
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "code" varchar(14) [pk, note: 'Language Code']
}

Table "sap.common.Countries" {
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "code" varchar(3) [pk, note: 'Country/Region Code']
}

Table "sap.common.Currencies" {
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "code" varchar(3) [pk, note: 'Currency Code']
  "symbol" varchar(5) [note: 'Currency Symbol']
  "minorUnit" smallint [note: 'Currency Minor Unit Fractions']
  "numcode" integer
  "exponent" integer
  "minor" varchar(255)
}

Table "sap.common.Timezones" {
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "code" varchar(100) [pk, note: 'Time Zone Code']
}

Table "sap.capire.bookshop.Books.texts" {
  "ID_texts" varchar(36) [pk]
  "locale" varchar(14) [note: 'Language Code']
  "ID" integer
  "title" varchar(255)
  "descr" varchar(255)
}

Table "sap.capire.bookshop.Genres.texts" {
  "locale" varchar(14) [pk, note: 'Language Code']
  "ID" varchar(36) [pk]
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
}

Table "sap.common.Languages.texts" {
  "locale" varchar(14) [pk, note: 'Language Code']
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "code" varchar(14) [pk, note: 'Language Code']
}

Table "sap.common.Countries.texts" {
  "locale" varchar(14) [pk, note: 'Language Code']
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "code" varchar(3) [pk, note: 'Country/Region Code']
}

Table "sap.common.Currencies.texts" {
  "locale" varchar(14) [pk, note: 'Language Code']
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "code" varchar(3) [pk, note: 'Currency Code']
}

Table "sap.common.Timezones.texts" {
  "locale" varchar(14) [pk, note: 'Language Code']
  "name" varchar(255) [note: 'Name']
  "descr" varchar(1000) [note: 'Description']
  "code" varchar(100) [pk, note: 'Time Zone Code']
}

Ref: "sap.capire.bookshop.Books"."author_ID" > "sap.capire.bookshop.Authors"."ID"
Ref: "sap.capire.bookshop.Books"."genre_ID" > "sap.capire.bookshop.Genres"."ID"
Ref: "sap.capire.bookshop.Genres"."parent_ID" > "sap.capire.bookshop.Genres"."ID"

TableGroup "sap.capire.bookshop" {
  "sap.capire.bookshop.Books"
  "sap.capire.bookshop.Authors"
  "sap.capire.bookshop.Genres"
}

TableGroup "sap.common" {
  "sap.common.Languages"
  "sap.common.Countries"
  "sap.common.Currencies"
  "sap.common.Timezones"
}

TableGroup "sap.capire.bookshop.Books" {
  "sap.capire.bookshop.Books.texts"
}

TableGroup "sap.capire.bookshop.Genres" {
  "sap.capire.bookshop.Genres.texts"
}

TableGroup "sap.common.Languages" {
  "sap.common.Languages.texts"
}

TableGroup "sap.common.Countries" {
  "sap.common.Countries.texts"
}

TableGroup "sap.common.Currencies" {
  "sap.common.Currencies.texts"
}

